<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html><head><title>AgriConnect</title><link rel="stylesheet" href="/css/style.css"><meta name="viewport" content="width=device-width, initial-scale=1"></head><body><%@ include file="partials/nav.jsp" %><section class="hero"><div><small>FARM TO MARKET, TOGETHER</small><h1>Good food begins<br><em>with good connections.</em></h1><p>Discover local produce, connect with farmers, and make every harvest count.</p><a class="btn" href="/products">Explore marketplace →</a> <a class="btn ghost" href="/register">Join AgriConnect</a></div><div class="art">🌾<b>GROW LOCAL<br>BUY FRESH</b></div></section><section class="stats"><div><b>${productCount}</b>Produce listings</div><div><b>3</b>Community roles</div><div><b>Direct</b>Farm connections</div></section><main class="page"><h2>Fresh picks from the field</h2><div class="cards"><c:forEach items="${products}" var="p"><article class="card"><div class="produce">🥬</div><small>${p.category}</small><h3>${p.name}</h3><p>${p.location} · ${p.farmer.fullName}</p><b class="price">₹${p.price}/${p.unit}</b><a href="/products/${p.id}">View details →</a></article></c:forEach></div></main><%@ include file="partials/footer.jsp" %></body></html>