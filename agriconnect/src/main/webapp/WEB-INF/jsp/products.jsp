<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html><head><title>Marketplace</title><link rel="stylesheet" href="/css/style.css"></head><body><%@ include file="partials/nav.jsp" %><main class="page"><h1>Marketplace</h1><form class="search"><input name="q" value="${q}" placeholder="Search product or category"><button class="btn">Search</button></form><div class="cards"><c:forEach items="${products}" var="p"><article class="card"><div class="produce">🌱</div><small>${p.category}</small><h3>${p.name}</h3><p>${p.location} · ${p.farmer.fullName}</p><b class="price">₹${p.price}/${p.unit}</b><p>${p.quantity} ${p.unit} available</p><a href="/products/${p.id}">View details →</a></article></c:forEach></div><c:if test="${empty products}">No products found.</c:if></main><%@ include file="partials/footer.jsp" %></body></html>