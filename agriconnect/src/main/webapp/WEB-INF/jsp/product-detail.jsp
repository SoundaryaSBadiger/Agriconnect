<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html><head><title>${product.name}</title><link rel="stylesheet" href="/css/style.css"></head><body><%@ include file="partials/nav.jsp" %><main class="page narrow"><div class="card"><div class="produce big">🌿</div><small>${product.category}</small><h1>${product.name}</h1><p>${product.description}</p><h2 class="price">₹${product.price}/${product.unit}</h2><p>Farmer: ${product.farmer.fullName} · ${product.location}</p><p>Stock: ${product.quantity} ${product.unit}</p><c:if test="${not empty success}"><p class="success">${success}</p></c:if><c:if test="${not empty error}"><p class="error">${error}</p></c:if><c:if test="${not empty currentUser && currentUser.role == 'BUYER'}"><form class="form" method="post" action="/orders/${product.id}"><label>Quantity<input type="number" name="quantity" min="1" max="${product.quantity}" value="1"></label><button class="btn">Place order</button></form></c:if><c:if test="${empty currentUser}"><a class="btn" href="/login">Login to order</a></c:if></div></main><%@ include file="partials/footer.jsp" %></body></html>