<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %><!doctype html><html><head><title>Product listing</title><link rel="stylesheet" href="/css/style.css"></head><body><%@ include file="partials/nav.jsp" %><main class="page narrow"><h1>Produce listing</h1><form:form method="post" modelAttribute="product" action="${product.id == null ? '/products' : '/products/'.concat(product.id).concat('/edit')}" cssClass="form"><label>Product name<form:input path="name"/></label><label>Category<form:select path="category"><form:option value="Vegetables"/><form:option value="Fruits"/><form:option value="Grains"/><form:option value="Dairy"/><form:option value="Other"/></form:select></label><label>Price<form:input path="price" type="number" step="0.01"/></label><label>Unit<form:select path="unit"><form:option value="kg"/><form:option value="quintal"/><form:option value="dozen"/><form:option value="litre"/><form:option value="piece"/></form:select></label><label>Quantity<form:input path="quantity" type="number"/></label><label>Location<form:input path="location"/></label><label>Description<form:textarea path="description"/></label><button class="btn">Save listing</button></form:form></main><%@ include file="partials/footer.jsp" %></body></html>