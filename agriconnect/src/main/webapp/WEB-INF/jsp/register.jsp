<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %><!doctype html><html><head><title>Register</title><link rel="stylesheet" href="/css/style.css"></head><body><%@ include file="partials/nav.jsp" %><main class="page narrow"><h1>Create account</h1><p class="error">${error}</p><form:form method="post" modelAttribute="user" action="/register" cssClass="form"><label>Full name<form:input path="fullName"/></label><label>Email<form:input path="email" type="email"/></label><label>Password<form:password path="password"/></label><label>Confirm password<input type="password" name="confirmPassword"></label><label>Role<form:select path="role"><form:option value="FARMER">Farmer</form:option><form:option value="VENDOR">Vendor</form:option><form:option value="BUYER">Buyer</form:option></form:select></label><label>Location<form:input path="location"/></label><button class="btn">Create account</button></form:form></main><%@ include file="partials/footer.jsp" %></body></html>